{
  "singleQuote": true,
  "semi": false,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@onrepeat/(.*)$",
    "",
    "^[.]"
  ],
  "importOrderTypeScriptVersion": "6.0.0",
  "tailwindStylesheet": "apps/web/app/globals.css"
}
