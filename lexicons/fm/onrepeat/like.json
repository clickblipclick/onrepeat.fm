{
  "lexicon": 1,
  "id": "fm.onrepeat.like",
  "defs": {
    "main": {
      "type": "record",
      "description": "A like on a jam.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "#strongRef" },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "strongRef": {
      "type": "object",
      "required": ["uri", "cid"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" }
      }
    }
  }
}
