# Encrypted session cookie secret — must be >= 32 chars. Generate: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-32+-char-random-string

# Public base URL of the app. Dev: http://127.0.0.1:3000  Prod: https://onrepeat.fm
PUBLIC_URL=http://127.0.0.1:3000

# OAuth mode: 'dev' (loopback client, no keyset) or 'prod' (hosted client_id + keyset)
OAUTH_MODE=dev

# Postgres for the dev/app database.
DATABASE_URL=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_test

# Integration tests (`pnpm test:int`) truncate tables, so they run against a separate
# database (created on demand) and never touch DATABASE_URL above. Override here if needed.
# DATABASE_URL_INTTEST=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_inttest

# Prod only (OAUTH_MODE=prod): JSON array of importable ES256 private signing keys
# (PEM or JWK strings). Wire into apps/web/lib/oauth-client.ts build() via JoseKey.
# OAUTH_PRIVATE_KEYS=["-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"]
