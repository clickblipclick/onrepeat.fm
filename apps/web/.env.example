# apps/web — copy to .env.local (gitignored). `pnpm setup` does this for you.

# Encrypted session-cookie secret — must be >= 32 chars. `pnpm setup` generates one.
# Manual: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-32+-char-random-string

# Public base URL. Dev must be the loopback IP (atproto loopback OAuth requires it).
PUBLIC_URL=http://127.0.0.1:3000

# OAuth mode: 'dev' (loopback client, no keyset) or 'prod' (hosted client_id + keyset).
OAUTH_MODE=dev

# Postgres connection (host processes use localhost:5432 — see README).
DATABASE_URL=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_test

# Optional: free YouTube Data API v3 key. When set, the post form flags pasted
# youtube.com links that aren't in the Music category so you can confirm before
# posting (soft warning only — nothing is blocked). Absent → no music check.
YOUTUBE_API_KEY=
