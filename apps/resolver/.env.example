# apps/resolver — copy to .env.local (gitignored). `pnpm setup` does this for you.

# Postgres connection (host processes use localhost:5432 — see README).
DATABASE_URL=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_test

# Cross-platform resolution (free APIs). Without these the resolver still runs and
# keeps each jam's source embed; it just won't add that provider's cross-links.
# Spotify: create an app at https://developer.spotify.com/dashboard (client-credentials).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 key from https://console.cloud.google.com (enable the API).
YOUTUBE_API_KEY=
