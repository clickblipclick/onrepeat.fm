# apps/resolver — copy to .env.local (gitignored). `pnpm setup` does this for you.

DATABASE_URL=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_test

# Cross-resolution: iTunes/Apple is keyless (always on). YouTube is optional — set a
# free YouTube Data API v3 key to add YouTube cross-links (absent → Apple-only).
YOUTUBE_API_KEY=

# Album-art persistence (Cloudflare R2). All five required to enable self-hosting;
# leave unset to keep hotlinking provider CDNs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ARTWORK_CDN_BASE_URL=
