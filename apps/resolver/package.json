{
  "name": "@onrepeat/resolver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local lib/main.ts",
    "start": "tsx --env-file-if-exists=.env.local lib/main.ts",
    "backfill": "tsx --env-file-if-exists=.env.local lib/main.ts --backfill",
    "backfill:artwork": "tsx --env-file-if-exists=.env.local lib/main.ts --backfill-artwork",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@onrepeat/core": "workspace:*",
    "@onrepeat/db": "workspace:*",
    "@onrepeat/music": "workspace:*",
    "@onrepeat/jobs": "workspace:*",
    "@onrepeat/lexicons": "workspace:*",
    "@onrepeat/service": "workspace:*",
    "@onrepeat/storage": "workspace:*",
    "kysely": "^0.29.4",
    "pg-boss": "^12.26.3"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
