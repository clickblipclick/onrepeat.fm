# apps/ingester — copy to .env.local (gitignored). `pnpm setup` does this for you.

# Postgres connection (host processes use localhost:5432 — see README).
DATABASE_URL=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_test

# Jetstream v2 origin (https; the SDK opens the websocket). Defaults to us-west.
# JETSTREAM_URL=https://jetstream.us-west.bsky.network

# Dev only: set to 1 to ignore stored cursors and tail from the live head, so freshly
# posted jams are picked up immediately. Leave unset in prod so restarts resume durably.
# INGESTER_LIVE_TAIL=1

# Recovery only: start from this cursor once — a Jetstream seq, or a unix-microsecond
# timestamp (>= 1e15; microseconds, not milliseconds). Unset it again after the deploy
# that needed it.
# INGESTER_START_CURSOR=
