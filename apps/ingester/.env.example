# apps/ingester — copy to .env.local (gitignored). `pnpm setup` does this for you.

# Postgres connection (host processes use localhost:5432 — see README).
DATABASE_URL=postgres://onrepeat:onrepeat@localhost:5432/onrepeat_test

# atproto relay websocket for the binary firehose (com.atproto.sync.subscribeRepos).
RELAY_URL=wss://bsky.network

# Dev only: set to 1 to ignore the stored cursor and tail from the live head, so freshly
# posted jams are picked up immediately instead of replaying the (huge) network backlog.
# Leave unset in prod so restarts resume durably from the saved cursor.
# INGESTER_LIVE_TAIL=1

# Dev only (pnpm dev:local): resolve DIDs against a local PLC instead of
# plc.directory, for the fully-local ephemeral network. Unset in normal dev/prod.
# PLC_DIRECTORY_URL=http://localhost:2582
