{
  "name": "onrepeat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently -k -n web,ingest,resolve -c blue,green,magenta \"pnpm --filter @onrepeat/web dev\" \"pnpm --filter @onrepeat/ingester dev\" \"pnpm --filter @onrepeat/resolver dev\"",
    "dev:web": "pnpm --filter @onrepeat/web dev",
    "dev:services": "concurrently -k -n ingest,resolve -c green,magenta \"pnpm --filter @onrepeat/ingester dev\" \"pnpm --filter @onrepeat/resolver dev\"",
    "test": "vitest run",
    "test:int": "pnpm --filter @onrepeat/db exec tsx src/inttest-create.ts && vitest run --config vitest.int.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @onrepeat/db run migrate",
    "seed": "pnpm --filter @onrepeat/db exec tsx ../../scripts/seed-dev.ts",
    "seed:clean": "pnpm --filter @onrepeat/db exec tsx ../../scripts/seed-dev.ts --clean"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "vite@<6.4.3": ">=6.4.3 <7",
      "undici@<6.28.0": ">=6.28.0 <7",
      "undici@8": ">=8.9.0 <9",
      "nodemailer@<9.1.1": ">=9.1.1 <10",
      "kysely@<0.28.14": "^0.28.14",
      "sharp@<0.35.4": ">=0.35.4",
      "brace-expansion@2": ">=2.1.4 <3",
      "qs@<6.16.0": ">=6.16.0 <7",
      "protobufjs@7": ">=7.6.5 <8",
      "body-parser@1": ">=1.20.6 <2"
    }
  }
}
